### create a new user
POST http://localhost:3000/auth/signup
Content-Type: application/json 

{
    "email": "unique1-email@email.com",
    "password": "passwordfortest"
}

### signin a  user
POST http://localhost:3000/auth/signin
Content-Type: application/json 

{
    "email": "unique1-email@email.com",
    "password": "passwordfortest"
}

### get the signed in user 
GET http://localhost:3000/auth/whoami


### test finding one user controller by id 
GET http://localhost:3000/auth/3

### test finding users controller by email 
GET http://localhost:3000/auth?email=kjbnfdbdb@email.com


### test deleting a user with a given id 
DELETE http://localhost:3000/auth/1

### update a user 
PATCH http://localhost:3000/auth/2
Content-Type: application/json 

{
    "email": "newEmail@g.com"
}

